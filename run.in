units           real
atom_style      full
boundary        p p p
processors       4 4 3
timestep        1.0

# ALL styles BEFORE read_data
pair_style      hybrid/overlay sw/mod lj/cut/coul/long 12.0 12.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  none
comm_modify     cutoff 20.0
kspace_style    pppm 1.0e-4

read_data       CPE_PEO_WSSe_LiTFSI_NEW_7024.data
special_bonds   lj/coul 0.0 0.0 0.5
special_bonds   lj/coul 0.0 0.0 0.5

mass            1   12.011
mass            2    1.008
mass            3   15.999
mass            4    6.941
mass            5   14.007
mass            6   32.065
mass            7   15.999
mass            8   12.011
mass            9   18.998
mass            10 183.840
mass            11  32.065
mass            12  78.971

pair_coeff * * sw/mod tmd.sw.mod NULL NULL NULL NULL NULL NULL NULL NULL NULL W S Se
pair_coeff  1  1  lj/cut/coul/long  0.0660  3.5000
pair_coeff  2  2  lj/cut/coul/long  0.0300  2.5000
pair_coeff  3  3  lj/cut/coul/long  0.1200  2.9000
pair_coeff  4  4  lj/cut/coul/long  0.0180  2.1260
pair_coeff  5  5  lj/cut/coul/long  0.1700  3.2500
pair_coeff  6  6  lj/cut/coul/long  0.2500  3.5500
pair_coeff  7  7  lj/cut/coul/long  0.2100  2.9600
pair_coeff  8  8  lj/cut/coul/long  0.0660  3.5000
pair_coeff  9  9  lj/cut/coul/long  0.0530  2.9500
pair_coeff 10 10  lj/cut/coul/long  0.0570  2.7340
pair_coeff 11 11  lj/cut/coul/long  0.2740  3.5940
pair_coeff 12 12  lj/cut/coul/long  0.2910  3.7460
# Cross pairs PEO+LiTFSI <-> WSSe (Lorentz-Berthelot)
pair_coeff  1 10  lj/cut/coul/long  0.0613  3.1170  # CT-W
pair_coeff  1 11  lj/cut/coul/long  0.1345  3.5470  # CT-S_W
pair_coeff  1 12  lj/cut/coul/long  0.1386  3.6230  # CT-Se
pair_coeff  2 10  lj/cut/coul/long  0.0414  2.6170  # HC-W
pair_coeff  2 11  lj/cut/coul/long  0.0907  3.0470  # HC-S_W
pair_coeff  2 12  lj/cut/coul/long  0.0934  3.1230  # HC-Se
pair_coeff  3 10  lj/cut/coul/long  0.0827  2.8170  # OS-W
pair_coeff  3 11  lj/cut/coul/long  0.1813  3.2470  # OS-S_W
pair_coeff  3 12  lj/cut/coul/long  0.1869  3.3230  # OS-Se
pair_coeff  4 10  lj/cut/coul/long  0.0320  2.4300  # Li-W
pair_coeff  4 11  lj/cut/coul/long  0.0702  2.8600  # Li-S_W
pair_coeff  4 12  lj/cut/coul/long  0.0724  2.9360  # Li-Se
pair_coeff  5 10  lj/cut/coul/long  0.0984  2.9920  # N_T-W
pair_coeff  5 11  lj/cut/coul/long  0.2158  3.4220  # N_T-S_W
pair_coeff  5 12  lj/cut/coul/long  0.2224  3.4980  # N_T-Se
pair_coeff  6 10  lj/cut/coul/long  0.1194  3.1420  # S_T-W
pair_coeff  6 11  lj/cut/coul/long  0.2617  3.5720  # S_T-S_W
pair_coeff  6 12  lj/cut/coul/long  0.2697  3.6480  # S_T-Se
pair_coeff  7 10  lj/cut/coul/long  0.1094  2.8470  # O_T-W
pair_coeff  7 11  lj/cut/coul/long  0.2399  3.2770  # O_T-S_W
pair_coeff  7 12  lj/cut/coul/long  0.2472  3.3530  # O_T-Se
pair_coeff  8 10  lj/cut/coul/long  0.0613  3.1170  # C_T-W
pair_coeff  8 11  lj/cut/coul/long  0.1345  3.5470  # C_T-S_W
pair_coeff  8 12  lj/cut/coul/long  0.1386  3.6230  # C_T-Se
pair_coeff  9 10  lj/cut/coul/long  0.0550  2.8420  # F-W
pair_coeff  9 11  lj/cut/coul/long  0.1205  3.2720  # F-S_W
pair_coeff  9 12  lj/cut/coul/long  0.1242  3.3480  # F-Se
pair_modify mix arithmetic
kspace_modify mesh 32 32 64 order 6

bond_coeff  1   268.0  1.529
bond_coeff  2   340.0  1.090
bond_coeff  3   320.0  1.410
bond_coeff  4   361.0  1.570
bond_coeff  5   637.0  1.437
bond_coeff  6   272.0  1.818
bond_coeff  7   367.0  1.323

angle_coeff  1   33.0  107.8
angle_coeff  2   37.5  110.7
angle_coeff  3   35.0  109.5
angle_coeff  4   50.0  109.5
angle_coeff  5   60.0  109.5
angle_coeff  6   35.0  125.6
angle_coeff  7   80.0  113.6
angle_coeff  8   55.0  100.2
angle_coeff  9   90.0  118.5
angle_coeff 10   72.0  106.7
angle_coeff 11   55.0  111.7
angle_coeff 12   55.0  107.1

dihedral_coeff  1   0.0000  0.0000  0.3000  0.0000
dihedral_coeff  2   0.0000  0.0000  0.4680  0.0000
dihedral_coeff  3   0.6500 -0.2500  0.6700  0.0000
dihedral_coeff  4   0.0000  0.0000  0.7600  0.0000
dihedral_coeff  5   0.0000  0.0000  1.1790  0.0000
dihedral_coeff  6   0.6500 -0.2500  0.6700  0.0000
special_bonds lj/coul 0.0 0.0 0.5

group  WSSe     type 10 11 12
group  PEO      type 1 2 3
group  Li       type 4
group  TFSI     type 5 6 7 8 9
group  polymer  type 1 2 3 4 5 6 7 8 9

neighbor        2.0  bin
neigh_modify    every 1 delay 0 check yes page 100000 one 2000

thermo          1000
thermo_style    custom step temp press density pe ke etotal lx ly lz

# STAGE 1: MINIMIZATION
print ">>> STAGE 1: Minimization"

# Fix broken bonds across PBC
fix  unwrap all momentum 1 linear 1 1 1 angular
unfix unwrap

fix  freeze WSSe setforce 0.0 0.0 0.0

# Unwrap molecules split across PBC before minimization

minimize  1.0e-4  1.0e-6  10000  100000
unfix  freeze
write_data  min.data
print ">>> Minimization done"

# STAGE 2: HEATING 300→600 K (2 ns)
print ">>> STAGE 2: Heating"
velocity  all  create  300.0  12345  dist gaussian  rot yes  mom yes
fix  npt_heat  polymer  nvt  temp  300.0  600.0  100.0
fix  wsse_spr  WSSe  spring/self  10.0
dump  d_heat  all  custom  20000  heat.lammpstrj  id mol type x y z
dump_modify  d_heat  sort id
thermo  2000
run  2000000
write_data  heat.data
unfix  npt_heat
unfix  wsse_spr
undump d_heat
print ">>> Heating done"

# STAGE 3: COOLING 600→400 K (2 ns)
print ">>> STAGE 3: Cooling"
fix  npt_cool  polymer  nvt  temp  600.0  400.0  100.0
fix  wsse_spr  WSSe  spring/self  10.0
thermo  2000
run  2000000
write_data  cool.data
unfix  npt_cool
unfix  wsse_spr
print ">>> Cooling done"

# STAGE 4: NPT EQUILIBRATION 400 K (20 ns)
print ">>> STAGE 4: Equilibration"
fix  npt_equil  polymer  npt  temp  400.0  400.0  100.0  aniso  1.0  1.0  1000.0
fix  wsse_spr  WSSe  spring/self  10.0
variable  rho  equal  density
fix  rho_log  all  ave/time  5000  1  5000  v_rho  file  density_equil.dat
dump  d_equil  all  custom  100000  equil.lammpstrj  id mol type x y z
dump_modify  d_equil  sort id
thermo  10000
run  20000000
write_data    equil.data
write_restart equil.restart
unfix  npt_equil
unfix  wsse_spr
unfix  rho_log
undump d_equil
print ">>> Equilibration done"

# STAGE 5: NVT PRODUCTION 400 K (50 ns)
print ">>> STAGE 5: Production"
fix  nvt_prod  all  nvt  temp  400.0  400.0  100.0
compute  msd_Li  Li  msd  com yes
fix  out_msd  Li  ave/time  500  1  500  c_msd_Li[4]  file  msd_Li.dat  title1 "# Step MSD"
compute  rdf_LiO  all  rdf  200  4 3
fix  out_rdf  all  ave/time  10000  100  1000000  c_rdf_LiO[*]  file  rdf_LiO.dat  mode vector
compute  rdf_LiWSSe  all  rdf  200  4 11  4 12
fix  out_rdfW  all  ave/time  10000  100  1000000  c_rdf_LiWSSe[*]  file  rdf_LiWSSe.dat  mode vector
compute  cZ  all  chunk/atom  bin/1d  z  0.0  1.0  units box
fix  out_rhoZ  all  ave/chunk  5000  200  1000000  cZ  density/mass  file  density_z.dat
dump  d_prod  all  custom  100000  prod.lammpstrj  id mol type x y z
dump_modify  d_prod  sort id
thermo  10000
thermo_style  custom  step  temp  press  density  pe  ke  c_msd_Li[4]
run  50000000
write_data    prod_end.data
write_restart prod_end.restart
unfix  nvt_prod
unfix  out_msd
unfix  out_rdf
unfix  out_rdfW
unfix  out_rhoZ
undump d_prod
print ">>> Production done"

# STAGE 6: DEFORMATION
print ">>> STAGE 6: Deformation"
read_restart  equil.restart
fix  nvt_mech  all  nvt  temp  400.0  400.0  100.0
variable  lz0      equal  lz
fix  def  all  deform  1  z  erate  1.0e-5  remap x
variable  strain   equal  (lz-v_lz0)/v_lz0
variable  stress_z equal  -pzz*1.01325e-4
fix  out_ss  all  ave/time  100  1  100  v_strain  v_stress_z  file  stress_strain.dat  title1 "# strain stress_GPa"
dump  d_mech  all  custom  10000  deform.lammpstrj  id type x y z
dump_modify  d_mech  sort id
thermo  1000
thermo_style  custom  step  temp  v_strain  v_stress_z  lz
run  3000000
write_data  deformed.data
print ">>> ALL DONE"
